[alias]
	cp = cherry-pick
	cpc = cherry-pick --continue
	cpa = cherry-pick --abort
	cps = cherry-pick --skip
	c = commit -s
	ca = commit -s --amend
	re = revert --no-edit
	rea = revert --abort
	rec = revert --continue
	rb = rebase
	ac = am --continue
	ab = am --abort
	as = am --skip
	lo = log --oneline
	un = diff --name-only --diff-filter=U --relative
	bl = blame
	tr = log --graph --oneline
	ck = checkout
	ss = show --stat
	mg = merge
	cl = clone
	fp = format-patch --full-index --zero-commit --no-signature --no-stat -N

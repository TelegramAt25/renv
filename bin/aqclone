#!/bin/bash

export workdir=$(pwd)

clo() {
  if [ $4 == "overridable" ]; then
      echo "deleting $1..."
      rm -rf "$1"
  fi
  if [ ! -d $1 ]; then
    echo "Cloning $2, branch $3"
    git clone "$2" "$1" -b "$3"
    echo
  else
    if [ $4 == "updatable" ]; then
      echo "syncing $1..."
      cd "$1"
      git pull
      cd $workdir
    else
      echo "$1 already exists and is not marked as updatable, skipping"
    fi
  fi
}

if [ -z "$1" ]; then echo "u forgor dt branch" && exit 1; fi

# device specific
clo device/oppo/A37 https://github.com/TelegramAt25/android_device_oppo_A37 $1 updatable
clo vendor/oppo https://github.com/TelegramAt25/proprietary_vendor_oppo_A37 lineage-17.1 updatable
clo kernel/oppo/msm8939 https://github.com/TelegramAt25/kernel_oppo_msm8939 niigo updatable
